# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB Atlas. Prefer the mongodb+srv form:
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shrinkless?retryWrites=true&w=majority"

# If SRV lookups fail locally (Node resolver pointing at 127.0.0.1 returns
# ECONNREFUSED), use the standard form instead. Get the shard hosts and
# replicaSet name from the cluster's SRV and TXT DNS records:
#   Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type SRV
#   Resolve-DnsName <cluster>.mongodb.net -Type TXT
# MONGODB_URI="mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/shrinkless?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
